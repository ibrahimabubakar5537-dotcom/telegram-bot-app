        "Open this page through your Telegram Mini App.";\
    \}\
\
    function closeApp() \{\
      tg.close();\
    \}\
\
    function escapeHTML(text) \{\
      return String(text)\
        .replace(/&/g, "&amp;")\
        .replace(/</g, "&lt;")\
        .replace(/>/g, "&gt;")\
        .replace(/"/g, "&quot;")\
        .replace(/'/g, "&#039;");\
    \}\
